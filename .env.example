# =============================================================================
# railhq.io Environment Configuration
# =============================================================================
# Copy this file to .env and adjust the values to your needs:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Data Directory
# -----------------------------------------------------------------------------
# Base directory for all RailHQ data (resources, setups, redis data, etc.)
# 
# Linux/macOS:   ~/railhq.io
# Windows:       C:/Users/YourUsername/railhq.io
#                (Use forward slashes, even on Windows!)
#
RAILHQ_DATA_DIR=~/railhq.io

# -----------------------------------------------------------------------------
# Operation Mode
# -----------------------------------------------------------------------------
# RAILHQ_LOCAL_MODE controls cookie and session behavior:
#   true  = Local/LAN mode - cookies work with IP addresses (recommended for home use)
#   false = Cloud mode - cookies bound to domain (for public hosting)
#
RAILHQ_LOCAL_MODE=true

# -----------------------------------------------------------------------------
# TLS/HTTPS Configuration
# -----------------------------------------------------------------------------
# RAILHQ_USE_TLS enables or disables HTTPS:
#   true  = HTTPS enabled (requires valid certificates)
#   false = HTTP only (recommended for local network)
#
RAILHQ_USE_TLS=false

# Path to TLS certificates (only needed if RAILHQ_USE_TLS=true)
# The directory should contain:
#   - fullchain.pem (certificate chain)
#   - privkey.pem (private key)
#
TLS_CERT_DIR=${RAILHQ_DATA_DIR}/resourcesRuntime/certificates

# Certificate password (leave empty if not password-protected)
TLS_CERT_PW=

# -----------------------------------------------------------------------------
# nginx Configuration
# -----------------------------------------------------------------------------
# nginx acts as reverse proxy and handles HTTP/HTTPS routing
#
# Available configurations:
#   nginx-http.conf  = HTTP only (use with RAILHQ_USE_TLS=false)
#   nginx-https.conf = HTTPS enabled (use with RAILHQ_USE_TLS=true)
#
NGINX_CFG_DIR=${RAILHQ_DATA_DIR}/resourcesRuntime/nginx
NGINX_CONF=nginx-http.conf

# -----------------------------------------------------------------------------
# Backup Configuration
# -----------------------------------------------------------------------------
# Directory where backups will be stored
#
BACKUP_DIRECTORY_PATH=${RAILHQ_DATA_DIR}/deployment

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
# Redis hostname (usually the Docker container name)
# Change only if using an external Redis instance
#
REDIS_HOST=railhq.io-redis

# -----------------------------------------------------------------------------
# Advanced Configuration (usually no changes needed)
# -----------------------------------------------------------------------------

# Additional TLS certificate directory (for legacy compatibility)
TLS_CERT_DIR2=${RAILHQ_DATA_DIR}/resourcesRuntime/certificates
