@page
@model railyWebIndex.Pages.Workspaces.OverviewModel
@{
    Layout = "_LayoutGeneral";
    ViewData["Title"] = Globals.AppName + " Arbeitsbereiche";
    ViewData["productName"] = Globals.ProductName;
    ViewData["subpageName"] = "Arbeitsbereiche";
}

@if (ViewData["errorMessage"] != null)
{
    <div class="alert alert-warning d-flex align-items-center" role="alert">
        @ViewData["errorMessage"]
    </div>
}

<style>
    main div div.riesWorkspaceContainer {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
    }
</style>

<script type="text/javascript">
    window.__workspaceBearerToken = "@Model.BearerToken";
    // Use dynamic service URL in local mode
    const API_HOST_IMPORT = window.getServiceUrl ? window.getServiceUrl() + '/api/WorkspaceImport' : '@Html.Raw(Model.ApiUrlImport)';
</script>

<link rel="stylesheet" type="text/css" href="/libs/w2ui-2.0/w2ui-2.0.min.css" />
<script src="/libs/w2ui-2.0/w2ui-2.0.min.js"></script>

<!-- Loading / Progress -->
<div id="loadingOverlay" class="hidden fixed inset-0 flex justify-center items-center z-50">
    <div class="loader animate-spin"></div>
</div>
<style>
    .loader {
        width: 48px;
        height: 48px;
        border: 4px solid #3b82f6; /* Blaue Farbe */
        border-top-color: transparent; /* Obere Seite unsichtbar */
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin
    {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }
</style>

<div class="p-4 sm:p-3">
    <div class="riesWorkspaceContainer">

        @if (Model.WorkspaceInfos.Count > 0)
                {
                <script type="text/javascript">
                    window.__workspaceBearerToken = "@Model.BearerToken";
                </script>

                foreach (var it in Model.WorkspaceInfos)
                {
                    if (it == null) continue;

                    <div class="riesWorkspaceTile p-3 w-full sm:w-auto">
                        <div class="text-xl font-semibold text-center text-gray-800 w-full">
                            @it.Name
                        </div>
                        <div class="text-gray-900 p-2 w-full flex flex-col">
                            <!-- Name und Öffnen-Button -->
                            <div class="flex flex-col items-center w-full">

                                <div class="mt-4 flex justify-center">
                                    <!-- Öffnen-Button -->
                                    <a href="@($"{Model.UrlToPlay}{it.Name}")"
                                       onclick="return checkMobile(event, this.href)"
                                       class="btn btn-primary flex items-center px-2 py-1 bg-gray-200 text-gray-800 rounded-md hover:bg-gray-300 transition-colors duration-300">
                                        <i class="fas fa-play-circle" style="margin-right: 5px;"></i>
                                        <span>Öffnen</span>
                                    </a>
                                    <button onclick="showPreview('@(Model.ApiUrl)', '@(it.Name)')"
                                            class="btn btn-primary flex items-center px-2 py-1 bg-gray-200 text-gray-800 rounded-md hover:bg-gray-300 transition-colors duration-300 ml-2">
                                        <i class="fas fa-image" style="margin-right: 5px;"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="mt-6 flex w-full">
                                <!-- Linke Spalte: Planinfos und Routeninfos -->
                                <div class="w-1/2 mr-4 flex flex-col items-start">
                                    <div class="mt-4">
                                        <h3 class="text-lg font-semibold text-gray-700">Planinfos:</h3>
                                        <ul class="mt-2 space-y-1 text-gray-800 text-sm">
                                            <li>@it.Items.NoSwitches <span class="text-blue-600">Weiche@(it.Items.NoSwitches == 1 ? "" : "n")</span></li>
                                            <li>@it.Items.NoSignals <span class="text-blue-600">Signal@(it.Items.NoSignals == 1 ? "" : "e")</span></li>
                                            <li>@it.Items.NoBlocks <span class="text-blue-600">Blöck@(it.Items.NoBlocks == 1 ? "" : "e")</span></li>
                                            <li>@it.Items.NoSensors <span class="text-blue-600">Sensor@(it.Items.NoSensors == 1 ? "" : "en")</span></li>
                                        </ul>
                                    </div>
                                    <div class="mt-4">
                                        <h3 class="text-lg font-semibold text-gray-700">Routeninfos:</h3>
                                        <ul class="mt-2 space-y-1 text-gray-800 text-sm">
                                            <li>@it.Routes.Count <span class="text-blue-600">Route@(it.Routes.Count == 1 ? "" : "n")</span></li>
                                        </ul>
                                    </div>
                                </div>

                                <!-- Rechte Spalte: Weitere Informationen und Aktionen -->
                                <div class="w-1/2 flex flex-col items-start">
                                    <div class="mt-6 flex flex-col space-y-1 text-sm">
                                        <a href="#" class="renameWorkspaceLink flex items-center text-gray-700 hover:text-blue-600 transition"
                                           data-wsname="@it.Name"
                                           data-serviceUrl="@Model.ApiUrl">
                                            <i class="fas fa-edit text-blue-500 mr-2"></i> Umbenennen
                                        </a>
                                        <a href="#" class="duplicateWorkspaceLink flex items-center text-gray-700 hover:text-blue-600 transition"
                                           data-wsname="@it.Name"
                                           data-serviceUrl="@Model.ApiUrl">
                                            <i class="fas fa-clone text-blue-500 mr-2"></i> Duplizieren
                                        </a>
                                        <a href="#" class="refreshWorkspaceLink flex items-center text-gray-700 hover:text-blue-600 transition"
                                           data-wsname="@it.Name"
                                           data-serviceUrl="@Model.ApiUrl">
                                            <i class="fas fa-sync text-gray-500 hover:text-blue-500 mr-2"></i> Aktualisieren
                                        </a>
                                        <br />
                                        <a href="#" class="deleteWorkspaceLink flex items-center text-gray-700 hover:text-red-600 transition"
                                           data-wsname="@it.Name"
                                           data-serviceUrl="@Model.ApiUrl">
                                            <i class="fas fa-trash-alt text-red-500 mr-2"></i> Löschen
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                } // foreach

                <!-- Bestätigungsdialog für Umbenennen und Löschen -->
                <div class="renameModal hidden fixed inset-0 bg-gray-500 bg-opacity-50 flex justify-center items-center">
                    <div class="bg-white p-6 rounded-lg w-96">
                        <h3 class="text-lg font-semibold text-blue-600">Workspace umbenennen</h3>
                        <input type="text" class="newWorkspaceName mt-2 w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none text-sm" placeholder="Neuer Name">
                        <div class="mt-4 flex justify-end">
                            <button class="renameConfirm bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-lg">Bestätigen</button>
                            <button class="renameCancel ml-2 bg-gray-300 hover:bg-gray-400 text-gray-800 px-4 py-2 rounded-lg">Abbrechen</button>
                        </div>
                    </div>
                </div>

                <div class="deleteModal hidden fixed inset-0 bg-gray-500 bg-opacity-50 flex justify-center items-center">
                    <div class="bg-white p-6 rounded-lg w-96">
                        <h3 class="text-lg font-semibold text-red-600">Workspace löschen</h3>
                        <p class="text-sm text-gray-700">Gib bitte den Namen des Workspaces ein, um die Löschung zu bestätigen:</p>
                        <input type="text" class="deleteWorkspaceName mt-2 w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:outline-none text-sm" placeholder="Name eingeben">
                        <div class="mt-4 flex justify-end">
                            <button class="deleteConfirm bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg">Löschen</button>
                            <button class="deleteCancel ml-2 bg-gray-300 hover:bg-gray-400 text-gray-800 px-4 py-2 rounded-lg">Abbrechen</button>
                        </div>
                    </div>
                </div>
            }


            <div class="riesWorkspaceTile p-3 w-full sm:w-auto" style="min-width: 267px;">
                <div class="text-gray-900 rounded-2xl w-full flex-col items-center justify-center">
                    <!-- Großes Plus-Symbol -->
                    <div class="p-0 text-center w-full">
                        <button class="createButton text-blue-500 text-6xl font-bold disabled:text-gray-400 transition"
                                data-url="@Html.Raw(Model.UrlToPlay)"
                                disabled>
                            +
                        </button>
                    </div>
                    <!-- Eingabefeld für den Workspacenamen -->
                    <input type="text" class="workspaceName mt-4 w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none text-sm"
                           placeholder="Namen eingeben..."
                           onkeydown="if (event.key === 'Enter') { event.preventDefault(); document.querySelector('.createButton:not(:disabled)')?.click(); }">
                    <!-- Import-Section -->
                    <div class="mt-12 text-center">
                        <p class="font-semibold text-lg text-gray-600">Rocrail-Plan Import</p>
                        <p class="text-xs text-gray-500">Rocrail plan.xml hochladen und importieren.</p>

                        <div class="mt-3 flex items-center justify-center gap-3">
                            <input type="file" style="width: 190px; max-width: 2000px;"
                                   class="fileInput border p-2 rounded-lg text-xs text-gray-700 cursor-pointer w-auto" accept=".xml">
                            <button class="importButton p-2 bg-gray-300 text-gray-700 rounded-lg shadow-md hover:bg-gray-400 transition">
                                <i class="fas fa-file-import text-sm"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Fehlermeldung Overlay -->
            <div id="errorImportOverlay" class="hidden fixed inset-0 bg-gray-500 bg-opacity-50 flex justify-center items-center">
                <!-- Fehlerbox -->
                <div class="bg-white p-3 rounded-lg w-96 shadow-lg flex flex-col items-center">
                    <h3 class="text-lg font-semibold text-blue-600">Fehler</h3>
                    <p class="errorMessage text-red-600 font-bold text-center mt-2"></p>
                    <button class="closeError mt-4 px-4 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600">Schließen</button>
                </div>
            </div>
            <style>
                /* Overlay nimmt die ganze Seite ein */
                #errorImportOverlay {
                    justify-content: center;
                    align-items: center;
                    position: fixed;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    background: rgba(0, 0, 0, 0.5);
                    z-index: 1000;
                }

                    /* Fehlerbox mittig fixieren */
                    #errorImportOverlay > div {
                        max-width: 400px;
                        text-align: center;
                        flex-direction: column;
                        align-items: center;
                        justify-content: center;
                    }

                /* Fehlertext-Styling */
                .errorMessage {
                    color: red;
                    font-weight: bold;
                    text-align: center;
                    margin-top: 10px;
                }

                /* Schließen-Button */
                .closeError {
                    cursor: pointer;
                }
            </style>

        </div>
    </div>