@page
@model railyWebIndex.Pages.Fleet.LocomotiveSummaryModel
@{
    Layout = "_LayoutGeneral";
    ViewData["Title"] = Globals.AppName + " Fleet Zusammenfassung";
    ViewData["productName"] = Globals.ProductName;
