@page
@using railyWebIndex
@model railyWebIndex.Pages.Auth.NewPasswordModel
@{
    Layout = "_LayoutLogin";
    ViewData["Title"] = Globals.AppName + " Neues Passwort";
    ViewData["productName"] = Globals.ProductName;
}

@if (ViewData["errorMessage"] != null)
{
    <div class="alert alert-warning d-flex align-items-center" role="alert">
        @if (@ViewData["errorTitle"] != null)
        {
            @ViewData["errorTitle"]
            <br />
        }
        @ViewData["errorMessage"]
    </div>
}

@if (ViewData["statusMessage"] != null)
{
    <div class="alert alert-success d-flex align-items-center" role="alert">
        🎉 @ViewData["statusMessage"]
    </div>
}

<script type="text/javascript">
    document.addEventListener("DOMContentLoaded", function () {
        const hash = window.location.hash.substring(1);
        const params = new URLSearchParams(hash);
        const accessToken = params.get("access_token");
        const refreshToken = params.get("refresh_token");

        if (accessToken) {
            document.getElementById("AccessToken").value = accessToken;
        }
        if (refreshToken) {
            document.getElementById("RefreshToken").value = refreshToken;
        }
        
        window.history.replaceState({}, document.title, window.location.pathname);
    });
</script>

<h1 class="title">Neues Passwort setzen</h1>

<form class="login100-form validate-form" method="post">

    @Html.AntiForgeryToken()

    <input type="hidden" id="AccessToken" name="AccessToken" asp-for="AccessToken" />
    <input type="hidden" id="RefreshToken" name="RefreshToken" asp-for="RefreshToken" />

    <div class="wrap-input100 validate-input m-b-18" data-validate="Passwort erforderlich">
        <span class="label-input100">Neues Passwort</span>
        <input class="input100" type="password" id="password" name="password" required placeholder="Neues Passwort">
        <span class="focus-input100"></span>
    </div>

    <div class="wrap-input100 validate-input m-b-18" data-validate="Passwort bestätigen">
        <span class="label-input100">Passwort bestätigen</span>
        <input class="input100" type="password" id="confirmPassword" name="confirmPassword" required placeholder="Passwort bestätigen">
        <span class="focus-input100"></span>
    </div>

    <div class="container-login100-form-btn">
        <button class="login100-form-btn" type="submit">
            Passwort zurücksetzen
        </button>
    </div>
</form>
