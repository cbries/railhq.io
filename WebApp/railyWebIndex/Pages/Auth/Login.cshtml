@page
@using railyWebIndex
@model railyWebIndex.Pages.Auth.LoginModel
@{
    Layout = "_LayoutLogin";
    ViewData["Title"] = Globals.AppName + " Anmeldung";
    ViewData["productName"] = Globals.ProductName;
}

@if (ViewData["errorMessage"] != null)
{
    <div class="alert alert-warning d-flex align-items-center" role="alert">
        @ViewData["errorMessage"]
    </div>
}

@if (ViewData["successMessage"] != null)
{
    <div class="alert alert-success d-flex align-items-center" role="alert">
        @ViewData["successMessage"]
    </div>
}

<!-- Hinweis zur lokalen Netzwerk-Nutzung -->
<div class="alert alert-info" role="alert" style="background-color: #e7f3ff; border-color: #b6d4fe; margin-bottom: 20px; font-size: 13px;">
    <i class="fas fa-home" style="margin-right: 8px;"></i>
    <strong>Familien-Anmeldung:</strong> 
    Diese Anmeldung dient zur Unterscheidung der Benutzer im Haushalt &ndash; 
    keine Enterprise-Sicherheit, nur lokaler Netzwerkbetrieb.
</div>

<form class="login100-form validate-form" method="post" id="loginForm">
    @Html.AntiForgeryToken()
    <div class="wrap-input100 validate-input m-b-26" data-validate="E-Mail oder Benutzername erforderlich">
        <span class="label-input100">E-Mail</span>
        <input class="input100" type="text" name="email" placeholder="">
        <span class="focus-input100"></span>
    </div>

    <div class="wrap-input100 validate-input m-b-18" data-validate="Passwort erforderlich">
        <span class="label-input100">Passwort</span>
        <input class="input100" type="password" name="password" placeholder="">
        <span class="focus-input100"></span>
    </div>

    <div class="container-login100-form-btn">
        <button class="login100-form-btn" type="submit">
            Einsteigen
        </button>
    </div>
</form>

<div class="text-center p-t-30">
    <a href="javascript:void(0)" onclick="openRegisterOverlay()" class="txt2">
        Noch keinen Account? Jetzt registrieren
    </a>
</div>

<!-- Register Overlay -->
<div id="registerOverlay" class="register-overlay" style="display: none;">
    <div class="register-overlay-content">
        <span class="register-close" onclick="closeRegisterOverlay()">&times;</span>
        <h3 class="text-center m-b-30">Registrierung</h3>
        
        <div id="registerError" class="alert alert-warning" style="display: none;"></div>
        <div id="registerSuccess" class="alert alert-success" style="display: none;"></div>
        
        <form id="registerForm" method="post" asp-page-handler="Register">
            @Html.AntiForgeryToken()
            <div class="wrap-input100 m-b-26">
                <span class="label-input100">E-Mail</span>
                <input class="input100" type="email" name="registerEmail" id="registerEmail" placeholder="" required>
                <span class="focus-input100"></span>
            </div>

            <div class="wrap-input100 m-b-18">
                <span class="label-input100">Passwort</span>
                <input class="input100" type="password" name="registerPassword" id="registerPassword" placeholder="" required minlength="6">
                <span class="focus-input100"></span>
            </div>

            <div class="wrap-input100 m-b-18">
                <span class="label-input100">Passwort bestätigen</span>
                <input class="input100" type="password" name="registerPasswordConfirm" id="registerPasswordConfirm" placeholder="" required minlength="6">
                <span class="focus-input100"></span>
            </div>

            <div class="container-login100-form-btn m-t-20">
                <button class="login100-form-btn" type="submit" onclick="return validateRegisterForm()">
                    Registrieren
                </button>
            </div>
        </form>
    </div>
</div>

<style>
    .register-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.7);
        z-index: 9999;
        display: flex;
        justify-content: center;
        align-items: center;
    }
    
    .register-overlay-content {
        background-color: #fff;
        padding: 40px 50px 40px 150px;
        border-radius: 10px;
        max-width: 550px;
        width: 95%;
        position: relative;
        box-shadow: 0 5px 30px rgba(0, 0, 0, 0.3);
    }
    
    .register-close {
        position: absolute;
        top: 15px;
        right: 20px;
        font-size: 28px;
        cursor: pointer;
        color: #666;
    }
    
    .register-close:hover {
        color: #333;
    }
    
    .txt2 {
        font-size: 14px;
        color: #666;
        text-decoration: underline;
    }
    
    .txt2:hover {
        color: #333;
    }
    
    #registerForm .wrap-input100 {
        width: 100%;
    }
    
    #registerForm .alert {
        margin-bottom: 20px;
    }
</style>

<script>
    function openRegisterOverlay() {
        document.getElementById('registerOverlay').style.display = 'flex';
        document.getElementById('registerError').style.display = 'none';
        document.getElementById('registerSuccess').style.display = 'none';
    }
    
    function closeRegisterOverlay() {
        document.getElementById('registerOverlay').style.display = 'none';
    }
    
    function validateRegisterForm() {
        var password = document.getElementById('registerPassword').value;
        var passwordConfirm = document.getElementById('registerPasswordConfirm').value;
        var email = document.getElementById('registerEmail').value;
        var errorDiv = document.getElementById('registerError');
        
        if (!email || email.indexOf('@@') === -1) {
            errorDiv.textContent = 'Bitte geben Sie eine gültige E-Mail-Adresse ein.';
            errorDiv.style.display = 'block';
            return false;
        }
        
        if (password.length < 6) {
            errorDiv.textContent = 'Das Passwort muss mindestens 6 Zeichen lang sein.';
            errorDiv.style.display = 'block';
            return false;
        }
        
        if (password !== passwordConfirm) {
            errorDiv.textContent = 'Die Passwörter stimmen nicht überein.';
            errorDiv.style.display = 'block';
            return false;
        }
        
        return true;
    }
    
    // Close overlay when clicking outside
    document.getElementById('registerOverlay').addEventListener('click', function(e) {
        if (e.target === this) {
            closeRegisterOverlay();
        }
    });
    
    // Close on Escape key
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeRegisterOverlay();
        }
    });
    
    // Debug: Log form submission
    document.addEventListener('DOMContentLoaded', function() {
        var loginForm = document.getElementById('loginForm');
        if (loginForm) {
            console.log('Login form found, attaching debug handler');
            
            // Direct submit button click handler
            var submitBtn = loginForm.querySelector('button[type="submit"]');
            if (submitBtn) {
                submitBtn.addEventListener('click', function(e) {
                    console.log('Submit button clicked');
                    
                    // Check if validation passes
                    var emailInput = loginForm.querySelector('input[name="email"]');
                    var passwordInput = loginForm.querySelector('input[name="password"]');
                    
                    console.log('Email value:', emailInput ? emailInput.value : 'not found');
                    console.log('Password value:', passwordInput ? (passwordInput.value ? '[filled]' : '[empty]') : 'not found');
                    
                    // Force submit if Enter was pressed or validation seems OK
                    if (emailInput && emailInput.value && passwordInput && passwordInput.value) {
                        console.log('Values present, form should submit');
                    }
                });
            }
            
            loginForm.addEventListener('submit', function(e) {
                console.log('Login form submit event fired');
            });
        } else {
            console.log('Login form NOT found!');
        }
    });
</script>
