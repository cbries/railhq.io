@page
@model railyWebIndex.Pages.FeaturesModel
@{
    Layout = "_LayoutGeneral";
    ViewData["Title"] = Globals.AppName + " Funktionalitäten";
    ViewData["productName"] = Globals.ProductName;
    ViewData["subpageName"] = "Funktionalitäten";
}

@if (ViewData["errorMessage"] != null)
{
    <div class="alert alert-warning d-flex align-items-center" role="alert">
        @ViewData["errorMessage"]
    </div>
}

<script src="/libs/alpine.min.js" defer></script>

<div class="max-w-6xl mx-auto p-6">
    <h1 class="text-3xl font-bold text-center mb-8">🚀 Roadmap</h1>

    <p class="text-lg text-center text-gray-700 mb-6">
        Unser Service wächst stetig! Wir arbeiten kontinuierlich daran, neue Features zu entwickeln, bestehende Funktionen zu verbessern und euch das beste Erlebnis zu bieten.
        Eure Meinung ist uns wichtig! Habt ihr Ideen oder Wünsche? Gebt uns gerne Feedback – eure Vorschläge helfen uns, den Service noch besser zu machen. 💡✨
    </p>

    <div class="text-center mb-6">
        <a href="/support/contact" class="inline-block px-5 py-2 text-white bg-blue-600 rounded-lg shadow-md hover:bg-blue-700 transition">
            💬 Jetzt Feedback geben!
        </a>
    </div>
    
    <style>
        [x-cloak] { display: none !important; }
    </style>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-2">
        @for (var idx = 0; idx < Model.Roadmap.Count; ++idx)
        {
            <div class="@(Model.Colors[idx]) p-2 border rounded-lg shadow-sm w-78">
                <h2 class="text-base font-medium mb-2 flex items-center">
                    <i class="fas fa-lightbulb text-yellow-500 mr-2 text-sm"></i> @(Model.Roadmap[idx].Step)
                </h2>
                <ul class="space-y-1">
                    @foreach (var it in Model.Roadmap[idx].Features)
                    {
                        <li x-data="{ open: false }">
                            <div class="p-1.5 bg-white rounded shadow-sm flex justify-between items-center cursor-pointer text-sm"
                                 x-on:click="open = !open">
                                @(Html.Raw(it.GetIconHtml()))
                                <span class="flex-1 text-left">@(it.Name)</span>
                                <i class="fas text-xs" :class="open ? 'fa-chevron-up' : 'fa-chevron-down'"></i>
                            </div>
                            <div x-show="open" x-cloak class="mt-1 p-1.5 bg-gray-200 rounded text-xs">
                                @(Html.Raw(it.Description))  
                            </div>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>

</div>