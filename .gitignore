coverage/
*.coverage
*.coveragexml
TestResults/

#
# Basis-Pfad für alle RailHQ-Daten (resources, resourcesSetups, redis)
# Unter Windows müssen auch Slashes verwendet werden
#
# Linux:   ~/railhq.io
# Windows: C:/Users/username/railhq.io
#
RAILHQ_DATA_DIR=/home/cbries/railhq.io

#
# OnPremise/Lokal-Modus
# RAILHQ_LOCAL_MODE=true  -> Cookies ohne Domain-Restriction (für 127.0.0.1/LAN-Zugriff)
# RAILHQ_LOCAL_MODE=false -> Cookies an Domain gebunden (für Cloud-Deployment)
#
RAILHQ_LOCAL_MODE=true

#
# TLS-Konfiguration
# RAILHQ_USE_TLS=true  -> HTTPS aktiviert (Port 5001 HTTPS, Port 5000 HTTP)
# RAILHQ_USE_TLS=false -> Nur HTTP (Port 5001)
#
RAILHQ_USE_TLS=false

#
# Pfad zum TLS-Zertifikat (nur relevant wenn RAILHQ_USE_TLS=true)
# Unter Windows müssen auch Slashes verwendet werden
#
TLS_CERT_DIR=${RAILHQ_DATA_DIR}/resourcesRuntime/certificates
TLS_CERT_DIR2=${RAILHQ_DATA_DIR}/resourcesRuntime/certificates
TLS_CERT_PW=

# nginx
# NGINX_CONF wird basierend auf RAILHQ_USE_TLS gewählt:
#   RAILHQ_USE_TLS=true  -> nginx-https.conf
#   RAILHQ_USE_TLS=false -> nginx-http.conf
NGINX_CFG_DIR=${RAILHQ_DATA_DIR}/resourcesRuntime/nginx
NGINX_CONF=nginx-http.conf

#
# Storage für Backups
#
BACKUP_DIRECTORY_PATH=${RAILHQ_DATA_DIR}/deployment

#
#
# var redisHost = Environment.GetEnvironmentVariable("REDIS_HOST") ?? builder.Configuration["redisDocker:Host"];
#
REDIS_HOST=railhq.io-redis
